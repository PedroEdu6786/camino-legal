    "test:browser": "node tests/analytics-browser.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
